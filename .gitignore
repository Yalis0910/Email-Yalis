# ==========================================
# Email-Yalis 隐私安全与环境忽略规则
# ==========================================

# 1. 本地持久化数据与邮件附件 (严禁提交真实邮件与附件)
/data/
**/data/
data/
attachments/
**/attachments/

# 2. 本地数据库文件 (严禁提交 SQLite 库及日志)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite*

# 3. 密钥、OAuth凭据与私密配置文件 (严禁泄露隐私信息)
*.env
*.env.*
.env
.env.*
credentials.json
**/credentials.json
client_secret*.json
**/client_secret*.json
token.json
tokens.json
**/token.json
**/tokens.json
service_account*.json
*.pem
*.key
*.pfx
*.p12

# 4. Python 缓存与虚拟环境
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
venv/
.venv/
env/
ENV/

# 5. 前端依赖与打包构建产物
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. 编辑器与操作系统缓存
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
.DS_Store
Thumbs.db
Desktop.ini

# 7. 日志与临时文件
logs/
*.log
*.tmp
*.TMP
*~*
scratch/

